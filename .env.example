# Copier ce fichier en .env.local et renseigner les valeurs.
# Les clés Turnstile ci-dessous sont les clés de test officielles de Cloudflare (validation toujours acceptée).

# Cloudflare Turnstile (anti-spam) : https://dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend (envoi des emails) : https://resend.com/api-keys
# Sans clé en local, le message s'affiche dans le terminal au lieu d'être envoyé.
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire (jamais écrite dans le code)
CONTACT_TO_EMAIL=
# Expéditeur : laisser vide pour utiliser l'adresse de test de Resend
CONTACT_FROM_EMAIL=
# Adresse publique du site (optionnel, par défaut https://alexandre-mandra.vercel.app)
NEXT_PUBLIC_SITE_URL=
